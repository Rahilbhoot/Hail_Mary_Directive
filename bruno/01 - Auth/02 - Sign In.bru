meta {
  name: 02 - Sign In
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/signin
  body: json
  auth: none
}

body:json {
  {
    "email": "shepard@alliance.mil",
    "password": "Password@123"
  }
}

script:post-response {
  if (res.body && res.body.data) {
    if (res.body.data.access_token) {
      bru.setEnvVar("token", res.body.data.access_token);
    }
    if (res.body.data.refresh_token) {
      bru.setEnvVar("refreshToken", res.body.data.refresh_token);
    }
  }
}
