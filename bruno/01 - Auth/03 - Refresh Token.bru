meta {
  name: 03 - Refresh Token
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refresh_token": "{{refreshToken}}"
  }
}

script:post-response {
  if (res.body && res.body.data && res.body.data.access_token) {
    bru.setEnvVar("token", res.body.data.access_token);
  }
}
