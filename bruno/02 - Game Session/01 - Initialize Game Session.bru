meta {
  name: 01 - Initialize Game Session
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/users/chat/session/init
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.body && res.body.data && res.body.data.session_id) {
    bru.setEnvVar("sessionId", res.body.data.session_id);
  }
}
